# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Comma-separated numeric Telegram user ids allowed to use the bot. Required.
TELEGRAM_ALLOWED_USER_IDS=11111111,22222222

# Optional comma-separated chat ids. When set, the bot only works in these
# chats. Leave empty to allow any chat that an allowlisted human uses.
TELEGRAM_ALLOWED_CHAT_IDS=

# Group trigger policy: "mention" (default) answers only mentions and replies.
# "all" answers every message from allowlisted humans in that chat.
TELEGRAM_TRIGGER=mention

# OpenCode V2 server. Defaults match a local server.
OPENCODE_API_URL=http://127.0.0.1:49374
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-me

# Where the bot keeps its SQLite state and temporary attachments.
DATA_DIR=/data

# Health and operator endpoint (bound to loopback inside the container).
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# Attachment limit in megabytes (also applies to voice notes and audio files).
MAX_ATTACHMENT_MB=20

# How long one agent turn may stay silent before the bot stops it and reports
# a timeout. Long coding tasks may need more than the default 30 minutes.
RUN_TIMEOUT_SECONDS=1800

# --- Voice input (speech-to-text) -------------------------------------------
# Any Whisper-compatible /audio/transcriptions endpoint. Leave both empty to
# disable voice input; the bot answers with a configuration hint instead.
STT_API_URL=http://speech-to-text:9000/v1
STT_API_KEY=local
STT_MODEL=whisper-large-v3-turbo
# Optional ISO language hint, e.g. es or en.
STT_LANGUAGE=
# multipart (OpenAI/Groq/whisper.cpp) or json (base64 input_audio, OpenRouter).
STT_REQUEST_FORMAT=multipart
# Optional note prefixed to the transcription before it reaches the agent.
STT_NOTE_PROMPT=

# --- Audio replies (text-to-speech) -----------------------------------------
# edge (no key), openai (OpenAI-compatible /audio/speech), or elevenlabs.
# Local Piper service shared with the music app. Use `edge` only if you want
# Microsoft's cloud voices instead.
TTS_PROVIDER=openai
TTS_API_URL=http://text-to-speech:9000/v1
TTS_API_KEY=local
TTS_MODEL=piper
# Default voice for normal replies (Castilian).
TTS_VOICE=es-ES-ElviraNeural
# Voice for explicit audio requests that do not name a language (English by
# default). "responde en castellano" switches to TTS_VOICE; "responde en
# inglés" switches here. Falls back to TTS_VOICE when empty.
TTS_VOICE_AUDIO=en-US-AriaNeural

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
